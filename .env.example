# Angular / Supabase client configuration
# Use the same variable names in Vercel for Preview and Production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Edge Function configuration. Do not expose these to the Angular client.
MAILEROO_API_KEY=your_maileroo_api_key
MAILEROO_FROM_EMAIL=
MAILEROO_FROM_NAME=Trotapie
MAILEROO_REPLY_TO=
