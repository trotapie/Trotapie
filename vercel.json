{
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/cotizacion/:id",
      "destination": "/api/share/cotizacion/:id?share=1"
    },
    {
      "source": "/share/comparativa/:id",
      "destination": "/api/share/comparativa/:id?share=1"
    },
    {
      "source": "/cotizacion/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(facebookexternalhit|FacebookExternalHit|Facebot|facebot|WhatsApp|whatsapp|Twitterbot|twitterbot|Xbot|xbot|LinkedInBot|linkedinbot|Slackbot|slackbot|Discordbot|discordbot|TelegramBot|telegrambot|SkypeUriPreview|skypeuripreview|meta-externalagent).*"
          }
        }
      ],
      "destination": "/api/share/cotizacion/:id?share=0"
    },
    {
      "source": "/comparativa/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(facebookexternalhit|FacebookExternalHit|Facebot|facebot|WhatsApp|whatsapp|Twitterbot|twitterbot|Xbot|xbot|LinkedInBot|linkedinbot|Slackbot|slackbot|Discordbot|discordbot|TelegramBot|telegrambot|SkypeUriPreview|skypeuripreview|meta-externalagent).*"
          }
        }
      ],
      "destination": "/api/share/comparativa/:id?share=0"
    },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
